# ══════════════════════════════════════════════════════════════════════════════
# Environment Variables Configuration
# ══════════════════════════════════════════════════════════════════════════════
# All variables must be prefixed with NEXT_PUBLIC_ to be accessible in the browser
# Copy this file to .env and fill in your actual values

# ── Google Analytics ──────────────────────────────────────────────────────────
# Used for tracking page views and user analytics
# Get your tracking ID from https://analytics.google.com
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Resend (Contact Form) ─────────────────────────────────────────────────────
# Used by /api/contact to send emails. Server-side only — no NEXT_PUBLIC_ prefix.
# Sign up at https://resend.com → API Keys. Verify soumya.io domain before deploying.
RESEND_API_KEY=

# ── Supabase (Blog View Counts) ───────────────────────────────────────────────
# Used by ViewTracker.js to store per-post view counts in Postgres
# Sign up at https://supabase.com → create a project → Settings → API
# URL: Your project's API URL (e.g., https://xxxxx.supabase.co)
# Anon Key: Your project's public anon/public key (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Premium Blog Configuration ────────────────────────────────────────────────
# Used to gate premium blog content behind unlock codes
# Codes: Comma-separated list of valid 8-digit unlock codes
# Example: 12345678,87654321,11223344
# Encryption Key: A unique secret key for encrypting codes in localStorage
# Example: my_super_secret_key_2024
# WARNING: Keep these values secret in production (use GitHub Actions secrets)
NEXT_PUBLIC_PREMIUM_CODES=
NEXT_PUBLIC_ENCRYPTION_KEY=
